{
  "expo": {
    "name": "plant_app",
    "slug": "plant_app",
    "version": "1.0.0",
    "platforms": ["ios", "android"],
    "orientation": "portrait",
    "scheme": "plantapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.absolutezero13.plant-app"
    },
    "android": {
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
