{
  "expo": {
    "name": "Plant App",
    "slug": "plant_app",
    "icon": "./assets/app-icon.png",
    "version": "1.0.0",
    "platforms": [
      "ios",
      "android"
    ],
    "orientation": "portrait",
    "scheme": "plantapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.absolutezero13.plant-app"
    },
    "android": {
      "predictiveBackGestureEnabled": false,
      "package": "com.absolutezero13.plantapp"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#28AF6E",
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
